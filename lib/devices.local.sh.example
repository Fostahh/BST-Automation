#!/usr/bin/env bash
# devices.local.sh.example — copy to lib/devices.local.sh (git-ignored) and fill in.
# This is machine-local configuration: it must never be committed.
#
#   cp lib/devices.local.sh.example lib/devices.local.sh
#
# Nothing here is required if you only ever attach ONE device at a time: any profile name
# then resolves to it, and the runner also accepts a raw adb serial typed at the prompt.
# Fill this in when you juggle several phones, or to give them names you recognise.

# --- 1) name your devices -----------------------------------------------------
# Replaces the placeholder list in devices.sh (device1 device2 device3). Use whatever
# labels you like — they only have to match the suffixes you use below, uppercased.
#DEVICE_NAMES="pixel8 galaxyA54 pixel7a"

# --- 2) adb serial per profile ------------------------------------------------
# See `adb devices`. The variable suffix is the profile name, uppercased:
#   profile "galaxyA54"  ->  BST_SERIAL_GALAXYA54
BST_SERIAL_DEVICE1="your-serial-here"
BST_SERIAL_DEVICE2="your-serial-here"

# --- 3) lock-screen PIN per profile (optional) --------------------------------
# Digits only (enter_pin types keyevents). Needed for the cases that reboot (2 and 3):
# the post-reboot unlock reads it directly, whereas the run-time prompt only fires if the
# screen is already locked at the start. Leave unset for a device you unlock by hand.
#
# An exported PIN is inherited by every child process the run spawns, adb and frida
# included, so set it only when you want unattended runs.
#BST_PIN_DEVICE1="123456"        # example only
#BST_PIN_DEVICE2=""
